# MagicSpace – šablóna nastavení
# Skopírujte tento súbor ako .env a vyplňte reálne hodnoty

ADMIN_EMAIL=vas@email.sk
GMAIL_USER=vas@gmail.com
# Gmail App Password (nie bežné heslo!) – návod: https://support.google.com/accounts/answer/185833
GMAIL_PASS=xxxx xxxx xxxx xxxx
# Silné heslo pre admin panel
ADMIN_PASSWORD=zmente-toto-heslo

# URL vašej stránky bez lomítka na konci
SITE_URL=https://magicspace.sk

# Podpisovaci kluc pre admin session cookie.
# Ak sa nevyplni, vygeneruje sa automaticky do suboru .secret_key
# Vygenerovat: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
